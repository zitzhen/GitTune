#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	# PPA source packages ship a vendor/ directory plus a .cargo/config.toml
	# that replaces crates-io; build offline when it is present.
	if [ -d vendor ]; then \
		cargo build --release --locked --offline; \
	else \
		cargo build --release --locked; \
	fi

override_dh_auto_install:
	install -D -m 0755 target/release/GitTune \
		debian/tmp/usr/bin/git-tune
