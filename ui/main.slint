import { Button, LineEdit, VerticalBox, HorizontalBox, ComboBox, Switch, ScrollView } from "std-widgets.slint";

// ── Palette (Adwaita dark inspired) ──
global Adw {
    out property <color> window-bg: #1b1b20;
    out property <color> sidebar-bg: #232329;
    out property <color> card-bg: #2c2c33;
    out property <color> well-bg: #3a3a42;
    out property <color> accent: #3584e4;
    out property <color> accent-hover: #4a8ff0;
    out property <color> text: #f2f2f5;
    out property <color> text-dim: #9a9aa3;
}

component Card inherits Rectangle {
    background: Adw.card-bg;
    border-radius: 12px;

    @children
}

component SectionTitle inherits Text {
    color: Adw.text-dim;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
}

component FieldLabel inherits Text {
    color: Adw.text-dim;
    font-size: 13px;
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected;
    callback clicked();

    height: 40px;
    border-radius: 8px;
    background: root.selected ? #ffffff1f : touch.has-hover ? #ffffff10 : transparent;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;

        Text {
            text: root.icon;
            color: root.selected ? Adw.text : Adw.text-dim;
            font-size: 15px;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.selected ? Adw.text : #d4d4da;
            font-size: 14px;
            font-weight: root.selected ? 700 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component PillButton inherits Rectangle {
    in property <string> label;
    callback clicked();

    width: 110px;
    height: 40px;
    border-radius: 20px;
    background: touch.pressed ? Adw.accent.darker(10%) : touch.has-hover ? Adw.accent-hover : Adw.accent;

    Text {
        text: root.label;
        color: white;
        font-size: 14px;
        font-weight: 700;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <string> value;

    height: 38px;
    background: Adw.well-bg;
    border-radius: 9px;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;

        for opt in root.options: Rectangle {
            border-radius: 7px;
            background: root.value == opt ? Adw.accent : seg-touch.has-hover ? #ffffff12 : transparent;

            Text {
                text: opt;
                color: root.value == opt ? white : Adw.text-dim;
                font-size: 13px;
                font-weight: root.value == opt ? 700 : 400;
            }

            seg-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.value = opt;
                }
            }
        }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;

    height: 46px;

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 2px;

        Text {
            text: root.label;
            color: Adw.text;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Switch {
            checked <=> root.checked;
        }
    }
}

export component MainWindow inherits Window {
    title: "GitTune";
    min-width: 920px;
    min-height: 620px;
    background: Adw.window-bg;

    in-out property <string> user-name;
    in-out property <string> user-email;

    in property <[string]> gpg-options;
    in-out property <string> gpg-selected-value;
    in-out property <string> gpg-custom-value;

    in property <[string]> branch-options;
    in-out property <string> branch-selected-value;
    in-out property <string> branch-custom-value;

    in-out property <bool> commit-gpgsign;
    in-out property <bool> tag-gpgsign;

    in-out property <string> sendemail-from;
    in-out property <string> sendemail-smtpuser;
    in-out property <string> sendemail-smtpserver;
    in-out property <string> sendemail-smtpserverport;

    in property <[string]> encryption-options;
    in-out property <string> encryption-selected-value;

    in property <string> status-text;
    callback save-clicked();

    property <bool> gpg-is-custom: root.gpg-selected-value == "Custom...";
    property <bool> branch-is-custom: root.branch-selected-value == "Custom...";
    in-out property <int> current-page: 0;

    property <string> page-title: root.current-page == 0 ? "Identity" : root.current-page == 1 ? "Signing & Defaults" : "Email Sending";

    HorizontalLayout {
        // ── Sidebar ──
        Rectangle {
            width: 240px;
            background: Adw.sidebar-bg;

            VerticalLayout {
                padding: 18px;
                padding-top: 22px;
                spacing: 4px;

                HorizontalLayout {
                    spacing: 10px;
                    height: 44px;

                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Adw.accent;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "GitTune";
                        color: Adw.text;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 12px;
                }

                NavItem {
                    icon: "◉";
                    label: "Identity";
                    selected: root.current-page == 0;
                    clicked => {
                        root.current-page = 0;
                    }
                }

                NavItem {
                    icon: "✎";
                    label: "Signing & Defaults";
                    selected: root.current-page == 1;
                    clicked => {
                        root.current-page = 1;
                    }
                }

                NavItem {
                    icon: "✉";
                    label: "Email Sending";
                    selected: root.current-page == 2;
                    clicked => {
                        root.current-page = 2;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                Text {
                    text: "v1.3.0";
                    color: Adw.text-dim;
                    font-size: 11px;
                    horizontal-alignment: left;
                }
            }
        }

        // ── Separator ──
        Rectangle {
            width: 1px;
            background: #ffffff10;
        }

        // ── Content ──
        Rectangle {
            horizontal-stretch: 1;
            background: Adw.window-bg;

            VerticalLayout {
                // Header
                Rectangle {
                    height: 76px;

                    Text {
                        x: 32px;
                        text: root.page-title;
                        color: Adw.text;
                        font-size: 24px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                // Scrollable cards
                ScrollView {
                    vertical-stretch: 1;

                    VerticalBox {
                        alignment: start;
                        padding-left: 32px;
                        padding-right: 32px;
                        padding-bottom: 24px;
                        spacing: 18px;

                        // ── Page: Identity ──
                        if root.current-page == 0: Card {
                            VerticalBox {
                                padding: 22px;
                                spacing: 10px;

                                SectionTitle {
                                    text: "Git identity (global)";
                                }

                                FieldLabel {
                                    text: "Name";
                                }

                                LineEdit {
                                    placeholder-text: "user.name";
                                    text <=> root.user-name;
                                }

                                FieldLabel {
                                    text: "Email";
                                }

                                LineEdit {
                                    placeholder-text: "user.email";
                                    text <=> root.user-email;
                                }
                            }
                        }

                        // ── Page: Signing & Defaults ──
                        if root.current-page == 1: Card {
                            VerticalBox {
                                padding: 22px;
                                spacing: 10px;

                                SectionTitle {
                                    text: "GPG signing key";
                                }

                                ComboBox {
                                    model: root.gpg-options;
                                    current-value <=> root.gpg-selected-value;
                                }

                                LineEdit {
                                    visible: root.gpg-is-custom;
                                    placeholder-text: "Key fingerprint or ID";
                                    text <=> root.gpg-custom-value;
                                }

                                SectionTitle {
                                    text: "Default branch";
                                }

                                ComboBox {
                                    model: root.branch-options;
                                    current-value <=> root.branch-selected-value;
                                }

                                LineEdit {
                                    visible: root.branch-is-custom;
                                    placeholder-text: "branch name";
                                    text <=> root.branch-custom-value;
                                }
                            }
                        }

                        if root.current-page == 1: Card {
                            VerticalBox {
                                padding: 22px;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                spacing: 4px;

                                SectionTitle {
                                    text: "Signing";
                                }

                                ToggleRow {
                                    label: "Sign commits with GPG";
                                    checked <=> root.commit-gpgsign;
                                }

                                Rectangle {
                                    height: 1px;
                                    background: #ffffff0d;
                                }

                                ToggleRow {
                                    label: "Sign tags with GPG";
                                    checked <=> root.tag-gpgsign;
                                }
                            }
                        }

                        // ── Page: Email Sending ──
                        if root.current-page == 2: Card {
                            VerticalBox {
                                padding: 22px;
                                spacing: 10px;

                                SectionTitle {
                                    text: "sendemail";
                                }

                                FieldLabel {
                                    text: "From";
                                }

                                LineEdit {
                                    placeholder-text: "Name <you@example.com>";
                                    text <=> root.sendemail-from;
                                }

                                FieldLabel {
                                    text: "SMTP username";
                                }

                                LineEdit {
                                    placeholder-text: "sendemail.smtpuser";
                                    text <=> root.sendemail-smtpuser;
                                }

                                HorizontalBox {
                                    spacing: 14px;

                                    VerticalBox {
                                        spacing: 6px;

                                        FieldLabel {
                                            text: "SMTP server";
                                        }

                                        LineEdit {
                                            placeholder-text: "smtp.example.com";
                                            text <=> root.sendemail-smtpserver;
                                        }
                                    }

                                    VerticalBox {
                                        spacing: 6px;

                                        FieldLabel {
                                            text: "Port";
                                        }

                                        LineEdit {
                                            width: 96px;
                                            input-type: number;
                                            placeholder-text: "465";
                                            text <=> root.sendemail-smtpserverport;
                                        }
                                    }
                                }
                            }
                        }

                        if root.current-page == 2: Card {
                            VerticalBox {
                                padding: 22px;
                                spacing: 10px;

                                SectionTitle {
                                    text: "Encryption";
                                }

                                Segmented {
                                    options: root.encryption-options;
                                    value <=> root.encryption-selected-value;
                                }
                            }
                        }
                    }
                }

                // ── Bottom bar ──
                Rectangle {
                    height: 68px;

                    HorizontalLayout {
                        padding-left: 32px;
                        padding-right: 32px;
                        spacing: 16px;

                        Text {
                            text: root.status-text;
                            color: Adw.text-dim;
                            font-size: 13px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        PillButton {
                            label: "Save";
                            clicked => {
                                root.save-clicked();
                            }
                        }
                    }
                }
            }
        }
    }
}
